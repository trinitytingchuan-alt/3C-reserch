// ============ 数据驱动：功能总览表 / Hero 统计 / 元信息（换公司只改 DATA，无需动 HTML/逻辑）============
function renderFlist(){
  const tb = document.getElementById('flistBody'); if(!tb) return;
  const top5no = {}; DATA.top5.forEach(d=>top5no[d.id]=d.no);
  tb.innerHTML = DATA.backlog.map(b=>{
    const stCls = b.st==='TOP5' ? 'top' : (b.st==='功能池' ? 'pool' : (b.st==='二级候选' ? 'watch' : 'exist'));
    const noPrefix = top5no[b.id] ? `<span class="rk">TOP${top5no[b.id]}</span> ` : '';
    const hasPrd = !!DATA.prds[b.id];
    const click = hasPrd ? ` onclick="openPrd('${b.id}')"` : '';
    const name = hasPrd ? `<a href="prd-${b.id}.html" onclick="openPrd('${b.id}');return false;">${b.name}</a>` : b.name;
    return `<tr${click}><td class="id">${noPrefix}${b.id}</td><td class="name">${name}</td><td class="cat">${b.cat}</td><td><span class="st ${stCls}">${b.st}</span></td><td class="id">${scoreOf(b.id)||b.score}</td></tr>`;
  }).join('');
}
// 综合分单一数据源：由 10 维维度分实时加权计算，杜绝与卡片/总览分不一致
function scoreOf(id){
  const sc = DATA.scores && DATA.scores[id];
  if(!sc || !sc.dims) return null;
  const W = sc.dims.reduce((a,d)=>a+d.w,0);
  return (sc.dims.reduce((a,d)=>a+d.w*d.s,0)/W).toFixed(1);
}
function renderHeroMeta(){
  const m = DATA.meta;
  const heroSub = document.querySelector('.hero-sub .desc'); if(heroSub) heroSub.textContent = m.desc;
  // Hero 标题 / eyebrow 由 DATA 注入（公司名不得写死）
  const heroEyebrow = document.getElementById('heroEyebrow'); if(heroEyebrow) heroEyebrow.textContent = m.brand + ' · ' + m.product + ' · 产品机会白皮书';
  const heroCo = document.getElementById('heroCo'); if(heroCo) heroCo.textContent = m.company;
  const heroTitle = document.getElementById('heroTitle'); if(heroTitle) heroTitle.textContent = m.productLine;
  // Hero 统计数字全部由 DATA 计算，杜绝写死
  const evLines = document.querySelectorAll('#heroStats .stat .num');
  if(evLines && evLines[0]) evLines[0].textContent = m.evidenceCount;
  if(evLines && evLines[1]){
    const allScores = Object.keys(DATA.scores).map(id=>parseFloat(scoreOf(id))).filter(v=>!isNaN(v));
    const sMin = allScores.length?Math.min(...allScores).toFixed(1):m.scoreMin;
    const sMax = allScores.length?Math.max(...allScores).toFixed(1):m.scoreMax;
    evLines[1].textContent = sMin + '–' + sMax;
  }
  if(evLines && evLines[2]) evLines[2].textContent = '≥ ' + m.top5Threshold;
  document.querySelectorAll('[data-threshold]').forEach(el=>el.textContent = m.top5Threshold);
  // 导航栏元信息
  const rfName = document.querySelector('.rf-name'); if(rfName) rfName.textContent = m.author;
  const rfRole = document.querySelector('.rf-role'); if(rfRole) rfRole.textContent = m.authorRole;
  // 报告标题 / 品牌
  const brandLogo = document.getElementById('railLogo'); if(brandLogo) brandLogo.src = m.brandLogo;
  const railMark = document.getElementById('railMark'); if(railMark) railMark.textContent = m.brand;
  const railSub = document.getElementById('railSub'); if(railSub) railSub.textContent = m.brandSub;
  const docTitle = document.getElementById('docTitle'); if(docTitle) docTitle.textContent = m.title;
  const docDesc = document.getElementById('docDesc'); if(docDesc) docDesc.content = m.desc;
  const rfGh = document.querySelector('.rf-gh'); if(rfGh) rfGh.textContent = m.authorGh;
  const rfMail = document.querySelector('.rf-mail'); if(rfMail) rfMail.textContent = m.authorMail;
  // 各 section 标题中的数字（证据链、功能总览等）由 DATA 注入
  document.querySelectorAll('[data-evcount]').forEach(el=>el.textContent = m.evidenceCount);
  document.querySelectorAll('[data-window]').forEach(el=>el.textContent = m.dataWindow);
  // 页脚
  const ftAuth = document.querySelector('.ft-author'); if(ftAuth) ftAuth.innerHTML = `作者：<a href="https://github.com/${m.authorGh}" target="_blank" rel="noopener">${m.author}</a> · <a href="mailto:${m.authorMail}">${m.authorMail}</a>`;
}
renderFlist();
renderHeroMeta();
renderMetaRow();
function renderMetaRow(){
  const m = DATA.meta;
  const top5 = DATA.top5.length;
  const pool = DATA.backlog.filter(b=>b.st==='功能池').length;
  const cand = DATA.backlog.filter(b=>b.st==='二级候选'||b.st==='已具备 · 升级补齐').length;
  const scores = DATA.top5.map(d=>d.score).concat(DATA.backlog.filter(b=>!isNaN(parseFloat(b.score))).map(b=>parseFloat(b.score)));
  const mn = Math.min(...scores).toFixed(1), mx = Math.max(...scores).toFixed(1);
  const setText=(id,v)=>{const el=document.getElementById(id); if(el) el.textContent=v;};
  setText('mrTop5',top5); setText('mrPool',pool); setText('mrCand',cand); setText('mrScore',mn+' – '+mx);
}

// ============ 渲染 TOP5（跳转独立 PRD 页）============
const t5 = document.getElementById('top5grid');
DATA.top5.forEach(d=>{
  const diff = (DATA.prds[d.id]&&DATA.prds[d.id].differentiation)?DATA.prds[d.id].differentiation:'';
  const el = document.createElement('div');
  el.className='card reveal';
  el.innerHTML = `
    <div class="fig">${DATA.fig.top5[d.icon]}</div>
    <span class="badge">TOP${d.no} · ${d.id}</span>
    <div class="layer">
      <div class="lower">
        <div class="panel">
          <h3>${d.title}</h3>
          <p class="val">${d.val}</p>
          <div class="chain">
            <div class="row"><span class="lab">场景</span><span class="txt">${d.scene}</span></div>
            <div class="row"><span class="lab">痛点</span><span class="txt">${d.pain}</span></div>
            <div class="row"><span class="lab">根因</span><span class="txt">${d.root}</span></div>
          </div>
        </div>
        <div class="foot">
          <div class="score"><span class="num">${scoreOf(d.id)||d.score}</span><span class="den">/100</span><span class="bar"><i data-w="${scoreOf(d.id)||d.score}"></i></span></div>
          <a class="btn-doc" href="prd-${d.id}.html" onclick="openPrd('${d.id}');return false;">查看完整需求文档 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
    </div>`;
  t5.appendChild(el);
});

// ============ 渲染 GTM（商业落地视角：卖给谁/怎么卖/多大规模）============
const gm = document.getElementById('gtmgrid');
DATA.gtm.forEach(d=>{
  const tamRow = (d.tam||[]).map(t=>`<span class="gtam"><b>${t[2]}</b> ${t[1]}</span>`).join('');
  const ch = (d.channel||'').split('+').map(c=>`<span class="gch">${c.trim()}</span>`).join('');
  const diff = (DATA.prds[d.id]&&DATA.prds[d.id].differentiation)?DATA.prds[d.id].differentiation:'';
  const entry = d.entry||[];
  const el = document.createElement('div');
  el.className='gcard reveal';
  el.innerHTML = `
    <div class="gfig">${DATA.fig.gtm[d.icon]}</div>
    <div class="gbody">
      <div class="gtag">${d.tag} · 商业落地</div>
      <h3>${d.title}</h3>
      <p class="glead"><span class="gpersp">市场视角</span>${d.lead}</p>
      ${diff?`<div class="gdiff"><span class="gdiff-k">GTM 差异化定位</span><span class="gdiff-v">${diff}</span></div>`:''}
      <div class="grow"><span class="glab">卖给谁</span><span class="gtxt">${d.audience}</span></div>
      <div class="grow"><span class="glab">怎么卖</span><span class="gtxt gch-wrap">${ch}</span></div>
      <div class="grow"><span class="glab">变现</span><span class="gtxt">${d.pricing}</span></div>
      <div class="grow gscale"><span class="glab">量级</span><span class="gtxt">${tamRow}</span></div>
      <div class="grow"><span class="glab">切入</span><span class="gtxt">${entry.join(' → ')}</span></div>
    </div>
    <div class="gfoot">
      <a class="btn-doc" href="prd-${d.id}.html" onclick="openGtm('${d.id}');return false;">查看完整商业落地策略 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>`;
  gm.appendChild(el);
});

// ============ 证据链：可筛选全量总表 + 三级核验（二级界面）============
const { dimMap:DIM_MAP, dimOverride:DIM_OVERRIDE, dimLabel:DIM_LABEL, level:LVL, filters:eviFilters, catHint:EV_CAT_HINT } = DATA.evidenceMeta;
const EVID = DATA.evidence.map(e=>({id:e[0],tag:e[1],sum:e[2],src:e[3],url:e[4],dim:DIM_OVERRIDE[e[0]]||DIM_MAP[e[1]]||'strategic'}));
const eviBody = document.getElementById('eviBody');
const eviCats = document.getElementById('eviCats');
const eviDetailWrap = document.getElementById('eviDetailWrap');
const eviToolbar = document.getElementById('eviToolbar');
let eviCur = null;
function renderEviCats(){
  eviCats.innerHTML = eviFilters.map(f=>{
    const rows = EVID.filter(e=>e.dim===f.k);
    const sample = rows.slice(0,2).map(e=>`<span class="evi-s"><b>${e.id}</b>${e.sum}</span>`).join('');
    return `<div class="evi-cat" data-dim="${f.k}">
      <div class="ec-head"><span class="ec-ic">${f.ic}</span><div class="ec-t"><div class="ec-n">${f.n}</div><div class="ec-cnt">${rows.length} 条证据</div></div><span class="ec-go">查看全部 →</span></div>
      <div class="ec-hint">${EV_CAT_HINT[f.k]}</div>
      <div class="ec-sample">${sample}</div>
    </div>`;
  }).join('');
  eviCats.querySelectorAll('.evi-cat').forEach(card=>{
    card.addEventListener('click',()=>showEviDetail(card.dataset.dim));
  });
}
function showEviDetail(dim){
  eviCur = dim;
  eviCats.style.display = 'none';
  eviDetailWrap.style.display = 'block';
  eviDetailWrap.classList.add('in');
  eviToolbar.innerHTML = '';
  eviFilters.forEach(f=>{
    const el=document.createElement('button');
    el.className='evi-filter'+(f.k===dim?' active':'');
    const cnt = EVID.filter(e=>e.dim===f.k).length;
    el.innerHTML = `${f.n} <span class="cnt">${cnt}</span>`;
    el.onclick=()=>{ eviCur=f.k; eviToolbar.querySelectorAll('.evi-filter').forEach(x=>x.classList.remove('active')); el.classList.add('active'); renderEvi(); },
    eviToolbar.appendChild(el);
  });
  renderEvi();
  eviDetailWrap.scrollIntoView({behavior:'smooth',block:'start'});
}
function eviBack(){ eviCur=null; eviDetailWrap.style.display='none'; eviCats.style.display='block'; eviCats.classList.add('in'); }
function renderEvi(){
  const rows = EVID.filter(e=>e.dim===eviCur);
  eviBody.innerHTML = rows.map(e=>`<tr data-id="${e.id}">
    <td class="eid">${e.id}</td>
    <td><span class="etag">${e.tag}</span></td>
    <td>${e.sum}</td>
    <td class="esrc"><a href="${e.url}" target="_blank" rel="noopener">${e.src}</a></td>
  </tr>`).join('');
  eviBody.querySelectorAll('tr').forEach(tr=>tr.addEventListener('click',e=>{
    if(e.target.tagName==='A') return;
    openEvi(tr.dataset.id);
  }));
}
renderEviCats();

// 证据弹窗
const eviMask=document.createElement('div');eviMask.className='modal-mask';eviMask.id='eviMask';
eviMask.innerHTML=`<div class="modal" id="eviModal"></div>`;document.body.appendChild(eviMask);
function openEvi(id){
  const e=EVID.find(x=>x.id===id); if(!e) return;
  const lv=LVL[id]||['L2','专业媒体'];
  document.getElementById('eviModal').innerHTML=`
    <div class="m-eid">${e.id} · ${e.tag}</div>
    <div class="m-tit">${e.src}</div>
    <div class="m-row"><div class="ml">三级核验</div><div class="mt"><span class="m-tag-pill">${lv[0]} · ${lv[1]}</span></div></div>
    <div class="m-row"><div class="ml">数据窗口</div><div class="mt">2025-05 — 2026-05（雷鸟 RayNeo 公开资料与第三方评测区间）</div></div>
    <div class="m-row"><div class="ml">证据摘要</div><div class="mt">${e.sum}</div></div>
    <div class="m-row"><div class="ml">来源</div><a class="m-src" href="${e.url}" target="_blank" rel="noopener">${e.url}</a></div>
    <button class="m-close" onclick="document.getElementById('eviMask').classList.remove('open')">关闭</button>`;
  eviMask.classList.add('open');
}
eviMask.addEventListener('click',e=>{ if(e.target===eviMask) eviMask.classList.remove('open'); });

// ============ 左侧导航：滚动进度 + 章节激活 + IO 渐显 ============
const railLinks=document.getElementById('railLinks');
const railProg=document.getElementById('railProg');
const secs=[...document.querySelectorAll('[id]')].filter(s=>['top','top5','flist','gtm','evidence','method'].includes(s.id));
function onScroll(){
  const h=document.documentElement;
  const max=h.scrollHeight-h.clientHeight;
  const p=max>0?Math.min(1,scrollY/max):0;
  if(railProg) railProg.style.transform=`scaleY(${p})`;
  let cur='top';
  secs.forEach(s=>{ if(s.getBoundingClientRect().top<=120) cur=s.id; });
  railLinks.querySelectorAll('a').forEach(a=>a.classList.toggle('active', a.dataset.sec===cur));
}
addEventListener('scroll',onScroll,{passive:true});
addEventListener('resize',onScroll);
onScroll();
const io=new IntersectionObserver((es)=>{ es.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); e.target.querySelectorAll('.bar i').forEach(b=>b.style.width=b.dataset.w+'%'); io.unobserve(e.target);} }); },{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

// ============ 10 维权重环（donut）============
const DIMS_W = DATA.dimsWeight;
(function(){
  const svg=document.getElementById('donut'); if(!svg) return;
  const cx=60,cy=60,r=46,sw=14; let acc=0; const ns="http://www.w3.org/2000/svg";
  const C=2*Math.PI*r;
  DIMS_W.forEach(([n,w])=>{
    const len=C*w/100;
    const s=document.createElementNS(ns,'circle');
    s.setAttribute('cx',cx);s.setAttribute('cy',cy);s.setAttribute('r',r);
    s.setAttribute('fill','none');s.setAttribute('stroke','var(--signal)');
    s.setAttribute('stroke-width',sw);
    s.setAttribute('stroke-dasharray',`${len} ${C-len}`);
    s.setAttribute('stroke-dashoffset',`${-acc}`);
    s.setAttribute('transform',`rotate(-90 ${cx} ${cy})`);
    svg.appendChild(s); acc+=len;
  });
  const t=document.createElementNS(ns,'text');
  t.setAttribute('x',cx);t.setAttribute('y',cy-2);t.setAttribute('text-anchor','middle');
  t.setAttribute('class','center');t.textContent='10 维';
  svg.appendChild(t);
  const t2=document.createElementNS(ns,'text');
  t2.setAttribute('x',cx);t2.setAttribute('y',cy+14);t2.setAttribute('text-anchor','middle');
  t2.setAttribute('class','center');t2.textContent='× 四专家';
  svg.appendChild(t2);
})();
document.getElementById('weights').innerHTML = DIMS_W.map(([n,w])=>`
  <div class="m-wrow"><span class="wl">${n}</span><span class="wbar"><i style="width:${w*3}%"></i></span><span class="wp">${w}%</span></div>`).join('');

// ============ GTM 9 段策略渲染 · 方案 C 版式（强图形化 / 标题徽章 / 去前导零 / 无证据编号）============
function renderGtmDoc(id){
  const g=DATA.gtms[id]||{}; const g0=DATA.gtm.find(x=>x.id===id)||{};
  // ICP 目标人群：支持结构化对象数组 [{grp,who,why,scale}] 或兼容旧字符串
  const audRows=(Array.isArray(g0.audience)?g0.audience:(g0.audience?[{grp:'',who:g0.audience}]:[]));
  const audienceStr=audRows.map(a=>`<div class="aud-card"><div class="aud-grp">${a.grp||''}</div><div class="aud-who">${a.who||''}</div>${a.why?`<div class="aud-line"><span class="aud-k">为何是目标</span><span class="aud-v">${a.why}</span></div>`:''}${a.scale?`<div class="aud-line"><span class="aud-k">规模信号</span><span class="aud-v">${a.scale}</span></div>`:''}</div>`).join('')||'<div class="aud-card"><div class="aud-who">—</div></div>';
  // 切入场景：支持对象数组 [{phase,action}] 或兼容旧字符串
  const entryRows=(Array.isArray(g0.entry)?g0.entry:(g0.entry?[g0.entry]:[]));
  const entryStr=entryRows.map((e,i)=>{
    const ph=(e&&typeof e==='object')?e.phase:(typeof e==='string'&&e.includes(':')?e.split(':')[0].trim():`阶段 ${i+1}`);
    const ac=(e&&typeof e==='object')?e.action:(typeof e==='string'&&e.includes(':')?e.split(':').slice(1).join(':').trim():e);
    return `<div class="ent-row"><div class="ent-ph">${ph}</div><div class="ent-ac">${ac}</div></div>`;
  }).join('')||'—';
  // TAM 漏斗：取 g0.tam 三段 [名称, 描述, 金额]，按金额降序算相对宽度
  const tamArr=(g0.tam||[]);
  const tamNums=tamArr.map(t=>{const m=String(t[2]).replace(/[^0-9.]/g,'');return parseFloat(m)||0;});
  const tamMax=Math.max(...tamNums,1);
  const tamFunnel=tamArr.map((t,i)=>{
    const pct=Math.max(6, Math.round(tamNums[i]/tamMax*100));
    return `<div class="tam-row"><div class="tam-l">${t[0]}</div><div class="tam-bar"><i data-w="${pct}"></i><span>${t[2]}</span></div><div class="tam-v">${t[1]}</div></div>`;
  }).join('');
  // 风险矩阵：概率/影响徽章
  const riskRow=(g.risks||[]).map(r=>{
    const p=(r[1]||'').includes('高')?'p-hi':'p-lo';
    const im=(r[2]||'').includes('高')?'i-hi':'i-lo';
    return `<div class="risk-card"><div class="risk-name">${r[0]} <span class="risk-badge ${p}">P ${r[1]}</span><span class="risk-badge ${im}">I ${r[2]}</span></div><div class="risk-why">${r[3]}</div><div class="risk-fix"><b>对策</b>${r[4]}</div></div>`;
  }).join('');
  const metRow=(g.metrics||[]).map(m=>`<div class="m-cell"><div class="m-k">${m.k}</div><div class="m-v">${m.target}</div><div class="m-bar"><i data-w="${Math.min(100,Math.round((parseFloat(String(m.target).replace(/[^0-9.]/g,''))||0)*10))}"></i></div></div>`).join('');
  // 上市传导路径：结构化四字段 [场景 / 人群 / 渠道 / 指标]，每点详情实、长度对齐
  const logicRows=(g.gtmLogic||[]).map((v,i)=>{
    const sc=v.scene||v[0]||'', au=v.audience||v[1]||'', ch=v.channel||v[2]||'', mt=v.metric||v[3]||'';
    return `<div class="lc-row"><div class="lc-no">${i+1}</div><div class="lc-body">
      <div class="lc-seg"><span class="lc-lab">场景</span><span class="lc-tx"><b>${sc}</b></span></div>
      <div class="lc-seg"><span class="lc-lab">人群</span><span class="lc-tx">${au}</span></div>
      <div class="lc-seg"><span class="lc-lab">渠道</span><span class="lc-tx">${ch}</span></div>
      <div class="lc-seg"><span class="lc-lab">指标</span><span class="lc-tx"><b>${mt}</b></span></div>
    </div></div>`;
  }).join('');
  return `
    <div class="gtm-doc">
      <div class="prd-sec" id="ps-01">
        <h3><span class="ps-no">1</span>市场测算 TAM / SAM / SOM<span class="ps-en">Market Sizing</span></h3>
        <div class="tam-funnel">${tamFunnel}</div>
        <p class="prd-p" style="margin-top:var(--s4)">${g.tamSamSom||''}</p>
      </div>

      <div class="prd-sec" id="ps-01b">
        <h3><span class="ps-no">1b</span>上市传导路径<span class="ps-en">Go-to-Market Logic Chain</span></h3>
        <div class="chain-h">场景 · 人群 · 渠道 · 指标</div>
        <div class="lc-grid">${logicRows||'<div class="lc-row"><div class="lc-no">1</div><div class="lc-body"><div class="lc-seg"><span class="lc-lab">场景</span><span class="lc-tx">—</span></div></div></div>'}</div>
      </div>

      <div class="prd-sec" id="ps-02">
        <h3><span class="ps-no">2</span>理想客户画像 ICP<span class="ps-en">Ideal Customer Profile</span></h3>
        <div class="sig-h2">目标人群 · Audience</div>
        <div class="aud-grid">${audienceStr}</div>
        <div class="sig-h2">切入场景 · Entry</div>
        <div class="ent-wrap">${entryStr}</div>
      </div>

      <div class="prd-sec" id="ps-03">
        <h3><span class="ps-no">3</span>定价与打包<span class="ps-en">Pricing</span></h3>
        <div class="price-hero">
          <div class="price-main"><div class="p-k">定价策略 · Strategy</div><div class="p-v">${g0.pricing||'—'}</div></div>
          <div class="price-anchor"><div class="a-k">竞品锚点 · Anchor</div><div class="a-v">${g.anchor||'—'}</div></div>
        </div>
      </div>

      <div class="prd-sec" id="ps-04">
        <h3><span class="ps-no">4</span>渠道策略<span class="ps-en">Channels</span></h3>
        <div class="chan-grid">${(g.channels||[]).map(c=>`<div class="chan-card"><div class="chan-t">${c.type}</div><div class="chan-d">${c.detail}</div></div>`).join('')||'<div class="chan-card"><div class="chan-t">—</div><div class="chan-d">（未配置）</div></div>'}</div>
      </div>

      <div class="prd-sec" id="ps-05">
        <h3><span class="ps-no">5</span>发布节奏<span class="ps-en">Launch Cadence</span></h3>
        <div class="cadence">${(g.launchCadence||[]).map(c=>`<div class="cd"><div class="cd-p">${c.phase}</div><div class="cd-a">${c.action}</div></div>`).join('')||'<div class="cd"><div class="cd-a">（未配置）</div></div>'}</div>
      </div>

      <div class="prd-sec" id="ps-06">
        <h3><span class="ps-no">6</span>营销协同<span class="ps-en">Smarketing</span></h3>
        <div class="prd-prose"><p>${g.smarketing||''}</p></div>
      </div>

      <div class="prd-sec" id="ps-07">
        <h3><span class="ps-no">7</span>核心指标<span class="ps-en">Metrics</span></h3>
        <div class="metric">${metRow||''}</div>
      </div>

      <div class="prd-sec" id="ps-08">
        <h3><span class="ps-no">8</span>风险与对策<span class="ps-en">Risks &amp; Mitigations</span></h3>
        <div class="risk-grid">${riskRow||''}</div>
      </div>

      <div class="prd-sec" id="ps-09">
        <h3><span class="ps-no">9</span>首批 100 用户<span class="ps-en">First 100 Users</span></h3>
        <div class="prd-prose"><p>${g.first100||''}</p></div>
      </div>

      <div class="prd-sec" id="ps-10">
        <h3><span class="ps-no">10</span>北极星指标<span class="ps-en">North Star</span></h3>
        <div class="gtm-flag">
          <div class="flag north"><div class="f-k">North Star</div><div class="f-big">${g.northStar||''}</div></div>
        </div>
      </div>
    </div>`;
}

// ============ 详细评分渲染（10 维 × 每维打分与理由 + 4 专家依据 + 加权聚合）============
function renderScores(id){
  const sc=DATA.scores[id]; if(!sc) return '';
  // 加权聚合计算：Σ(维度分×权重)
  const dimRows=sc.dims.map((d,i)=>`
    <div class="sd-row">
      <div class="sd-i">${String(i+1).padStart(2,'0')}</div>
      <div class="sd-main">
        <div class="sd-top"><span class="sd-name">${d.n}</span><span class="sd-w">权重 ${d.w}%</span></div>
        <div class="sd-bar"><i style="width:${d.s}%"></i></div>
        <p class="sd-why">${d.why}</p>
      </div>
      <div class="sd-score">${d.s}</div>
    </div>`).join('');
  const expertRows=sc.experts.map((e,i)=>`
    <div class="sd-ex">
      <div class="sd-ex-head"><span class="sd-ex-ico">${String(i+1).padStart(2,'0')}</span><span class="sd-ex-name">${e.n}专家</span><span class="sd-ex-score">${e.s}</span></div>
      <p class="sd-ex-why">${e.why}</p>
    </div>`).join('');
  // 加权聚合计算（权重合计 90，按占比分配）
  const WSUM = sc.dims.reduce((a,d)=>a+d.w,0);
  const weighted = sc.dims.reduce((acc,d)=>acc+d.w*d.s,0)/WSUM;
  const finalScore = weighted;
  return `
    <div class="sd-wrap">
      <div class="sd-summary">
        <div class="sd-sum-main"><div class="sd-sum-n">${finalScore}</div><div class="sd-sum-k">综合分 / 100</div></div>
        <div class="sd-sum-txt">由 10 维（市场化→趋势顺应）× 四专家（产品/市场/用户/硬件）加权聚合，各维度权重按占比分配、合计 ${WSUM}。综合分 = Σ(维度分 × 权重) ÷ 权重合计。本需求加权计算约 <b>${weighted.toFixed(1)}</b>，与进入 TOP5 的综合分一致。</div>
      </div>
      <div class="sd-dims">${dimRows}</div>
      <div class="sd-experts">
        <div class="sd-sec-h">四专家评审依据</div>
        <div class="sd-ex-grid">${expertRows}</div>
      </div>
      <div class="sd-note">综合分 ≥ 90 方进入 TOP5（本需求 ${finalScore}）；不足 90 则补强真实证据而非改分。</div>
    </div>`;
}

// ============ PRD 全屏覆盖层（二级界面）============
const prdLayer=document.createElement('div');prdLayer.className='overlay';prdLayer.id='prdLayer';
document.body.appendChild(prdLayer);
function openPrd(id){
  // 二级页面入口统一为完整 PRD 覆盖层（renderPrdFull）；无完整 PRD 数据则无二级界面
  if(DATA.prds[id]) return renderPrdFull(id);
  return;
}
function renderPrdFull(id){
  const d=DATA.top5.find(x=>x.id===id)||{}; const p=DATA.prds[id];
  if(!p) return;
  const back=DATA.backlog.find(b=>b.id===id)||{};
  const sc=DATA.scores[id]||{};
  const list=(arr)=>`<ul class="prd-list">${arr.map(x=>`<li>${x}</li>`).join('')}</ul>`;
  const scen=p.scenarios.map(s=>`<div class="pcard"><div class="pl">${s[0]}</div><div class="pt">${s[1]}</div></div>`).join('');
  const met=p.metrics.map(m=>`<div class="m-cell"><b>${m[0]}</b><span>${m[1]}</span><div class="m-bar"><i data-w="${Math.min(100,Math.round((parseFloat(String(m[1]).replace(/[^0-9.]/g,''))||0)*10))}"></i></div></div>`).join('');
  const riskRows=p.risks.map(r=>`<tr><td>${r[0]}</td><td>${r[1]}</td><td>${r[2]}</td><td>${r[3]}</td><td>${r[4]}</td></tr>`).join('');
  prdLayer.innerHTML=`
    <div class="overlay-bar">
      <span class="ob-id">${d.id||id} · ${d.rank||back.st||'功能池'}</span>
      <span class="ob-title">${d.title||back.name||id}</span>
      <div class="ob-close" onclick="closePrd()">✕</div>
    </div>
    <div class="wrap overlay-main">
    <div class="prd-layout">
      <aside class="prd-aside">
        <div class="as-h">需求文档目录</div>
        <nav class="overlay-nav">
          <a onclick="prdGo('ps-01')"><span class="n">01</span>背景与目标</a>
          <a onclick="prdGo('ps-02')"><span class="n">02</span>目标用户</a>
          <a onclick="prdGo('ps-03')"><span class="n">03</span>用户场景与机会</a>
          <a onclick="prdGo('ps-03b')"><span class="n">03b</span>传导路径与价值链路</a>
          <a onclick="prdGo('ps-04')"><span class="n">04</span>解决方案</a>
          <a onclick="prdGo('ps-05')"><span class="n">05</span>成功指标</a>
          <a onclick="prdGo('ps-06')"><span class="n">06</span>风险对策</a>
          <a onclick="prdGo('ps-07')"><span class="n">07</span>排期路线</a>
          <a onclick="prdGo('ps-08')"><span class="n">08</span>评分摘要</a>
          <a onclick="prdGo('ps-09')"><span class="n">09</span>支撑证据</a>
        </nav>
      </aside>
      <div class="prd-main prd-hero">
      <div class="ph-rank">${d.rank?d.rank+' · ':''}${(d.score||sc.final)?('综合分 '+(d.score||sc.final)+' · '):''}需求定位：功能补齐 / 升级（非从零建设）</div>
      <div class="prd-hero-grid">
        <div>
          <h1>${d.title||back.name||id}</h1>
          <p class="ph-val">${d.val||p.background||''}</p>
          ${(scoreOf(id)||sc.final)?`<div class="ph-score"><span class="n">${scoreOf(id)||sc.final}</span><span class="d">/ 100 · 10 维 × 四专家加权</span></div>`:''}
        </div>
        <figure class="ph-figure">${DATA.fig.prd[id]||DATA.fig.prd[d.icon]||DATA.fig.prd['ID-002']}</figure>
      </div>
      <div class="hero-tri">
        <div><div class="ht-k">用户场景</div><div class="ht-v">${d.scene||(p.background&&p.background[0])||''}</div></div>
        <div><div class="ht-k">核心痛点</div><div class="ht-v">${d.pain||(p.background&&p.background[1])||''}</div></div>
        <div><div class="ht-k">根因定位</div><div class="ht-v">${d.root||(p.background&&p.background[2])||''}</div></div>
      </div>
      <div class="derive">
        <div class="derive-head">推导链路 · Derivation</div>
        <div class="derive-chain">
          <div class="derive-step"><div class="ds-ico">01</div><div class="ds-l">用户场景</div><div class="ds-t">${d.scene||(p.background&&p.background[0])||''}</div></div>
          <div class="derive-step"><div class="ds-arrow">→</div><div class="ds-ico">02</div><div class="ds-l">体验缺口</div><div class="ds-t">${d.pain||(p.background&&p.background[1])||''}</div></div>
          <div class="derive-step"><div class="ds-arrow">→</div><div class="ds-ico">03</div><div class="ds-l">根因</div><div class="ds-t">${d.root||(p.background&&p.background[2])||''}</div></div>
          <div class="derive-step"><div class="ds-arrow">→</div><div class="ds-ico">04</div><div class="ds-l">方案</div><div class="ds-t">${p.differentiation}</div></div>
        </div>
        <div class="derive-evs"><span class="de-lab">支撑证据</span>${(DATA.funcEvidence[d.id||id]||[]).map(e=>`<a class="ev-chip" href="#evidence" onclick="closePrd();setTimeout(()=>location.hash='#evidence',60);return false;">${e}</a>`).join('')}</div>
      </div>

      <div class="prd-sec">
        <h3><span class="ps-no">01</span>背景与目标<span class="ps-en">Background &amp; Objective</span></h3>
        <div class="prd-prose"><p>${list(p.background)}</p></div>
        <div class="sig-grid">
          <div class="sig-card"><div class="sig-h">竞品信号 · Competitor</div><div class="sig-b">${p.competitorSignal}</div></div>
          <div class="sig-card"><div class="sig-h">趋势信号 · Trend</div><div class="sig-b">${p.trendSignal}</div></div>
        </div>
        <div class="prd-pull">目标：在现有硬件 / 生态底座上补齐该能力，把体验缺口转为差异化卖点，而非重新立项。</div>
      </div>

      <div class="prd-sec">
        <h3><span class="ps-no">02</span>目标用户<span class="ps-en">Target Users</span></h3>
        ${list(p.users)}
      </div>

      <div class="prd-sec">
        <h3><span class="ps-no">03</span>用户场景与机会<span class="ps-en">User Scenarios &amp; Opportunity</span></h3>
        <div class="scn-grid">
          <div class="scn-card"><div class="scn-no">SCENE</div><div class="scn-t">使用场景</div><div class="scn-d">${d.scene||(p.background&&p.background[0])||''}</div></div>
          <div class="scn-card"><div class="scn-no">PAIN</div><div class="scn-t">核心痛点</div><div class="scn-d">${d.pain||(p.background&&p.background[1])||''}</div></div>
          <div class="scn-card"><div class="scn-no">ROOT</div><div class="scn-t">根因定位</div><div class="scn-d">${d.root||(p.background&&p.background[2])||''}</div></div>
          <div class="scn-card"><div class="scn-no">EDGE</div><div class="scn-t">差异化内核</div><div class="scn-d">${p.differentiation}</div></div>
        </div>
      </div>

      <div class="prd-sec" id="ps-03b">
        <h3><span class="ps-no">03b</span>传导路径与价值链路<span class="ps-en">Logic &amp; Value Chain</span></h3>
        <div class="chain-sec">
          <div class="chain-h">业务逻辑 · 触发 → 处理 → 边界 / 兜底</div>
          <div class="chain-flow">${(p.logicChain||[]).map((c,i)=>`<div class="chain-node"><span class="cn-no">${String(i+1).padStart(2,'0')}</span><span class="cn-t">${c}</span></div>`).join('<div class="chain-arrow">→</div>')}</div>
        </div>
        <div class="chain-sec" style="margin-top:var(--s5)">
          <div class="chain-h">价值传导 · 痛点 → 方案 → 用户价值 → 商业价值</div>
          <div class="value-flow">${(p.valueChain||[]).map(v=>`<div class="value-row"><span class="vt">${v}</span></div>`).join('')}</div>
        </div>
      </div>

      <div class="prd-sec">
        <h3><span class="ps-no">04</span>解决方案<span class="ps-en">Solution</span></h3>
        <div class="prd-prose"><p>${list(p.solution)}</p></div>
        <div class="prd-pull">差异化内核：${p.differentiation}</div>
        <div class="prd-note">TAM 估算：${p.tam}</div>
      </div>

      <div class="prd-sec">
        <h3><span class="ps-no">05</span>成功指标<span class="ps-en">Metrics</span></h3>
        <div class="metric">${met}</div>
      </div>

      <div class="prd-sec">
        <h3><span class="ps-no">06</span>风险与对策<span class="ps-en">Risks &amp; Mitigations</span></h3>
        <table class="prd-table"><thead><tr><th>风险</th><th>概率</th><th>影响</th><th>说明</th><th>对策</th></tr></thead><tbody>${riskRows}</tbody></table>
      </div>

      <div class="prd-sec">
        <h3><span class="ps-no">07</span>排期路线<span class="ps-en">Timeline</span></h3>
        ${list(p.plan)}
      </div>

      <div class="prd-sec">
        <h3><span class="ps-no">08</span>评分摘要<span class="ps-en">Decision Summary</span></h3>
        ${renderScores(id)}
        <div class="prd-note">综合评分 ${scoreOf(id)||sc.final||back.score||'—'}/100 · 达 TOP5 决策门槛，立项依据见下。</div>
      </div>

      <div class="prd-sec prd-evsec">
        <h3><span class="ps-no">09</span>支撑证据<span class="ps-en">Evidence</span><span class="ev-count">${evCount(d.id||id)} 条</span></h3>
        <p class="prd-sec-lead">以下证据按本需求真实归属，跨「市场 / 竞品 / 用户 / 战略」四维交叉，单点来源仅作假设、不定义根因。完整证据链见文末附录。</p>
        <div class="ev-mini">
          ${(DATA.funcEvidence[d.id||id]||[]).map(id=>{const e=EVID.find(x=>x.id===id);if(!e)return '';return `<a class="ev-inline" href="${e.url}" target="_blank" rel="noopener" title="${e.tag} · ${e.sum}">${e.id}</a>`;}).join('')}
        </div>
        <a class="ev-all" href="#evidence" onclick="closePrd();setTimeout(()=>location.hash='#evidence',60);return false;">查看全量证据链 E001–E104 →</a>
      </div>
    </div>
    </div>
    </div>`;
  prdLayer.querySelectorAll('.prd-sec').forEach((s,i)=>{ s.id='ps-'+(i+1).toString().padStart(2,'0'); });
  bindPrdNav();
  prdLayer.classList.add('open');
  prdLayer.scrollTop=0;
  // 触发 overlay 内进度条 / 漏斗动画
  requestAnimationFrame(()=>{ setTimeout(()=>{ prdLayer.querySelectorAll('[data-w]').forEach(b=>{ b.style.width=b.dataset.w+'%'; }); }, 80); });
}
function prdGo(id){ const el=prdLayer.querySelector('#'+id); if(el) el.scrollIntoView({behavior:'smooth',block:'start'}); }
function bindPrdNav(){
  const secs=[...prdLayer.querySelectorAll('.prd-sec')];
  const links=[...prdLayer.querySelectorAll('.overlay-nav a')];
  const setActive=(i)=>{ if(i<0) i=0; if(i>=links.length) i=links.length-1; links.forEach((a,k)=>a.classList.toggle('active',k===i)); };
  // 以"当前滚动位置上方最近的 section"为激活项：消除多节同时入触发区导致的乱跳
  const onScroll=()=>{
    const top=prdLayer.scrollTop;
    let cur=0;
    for(let i=0;i<secs.length;i++){
      if(secs[i].offsetTop - prdLayer.offsetTop - 96 <= top) cur=i; else break;
    }
    setActive(cur);
  };
  prdLayer.onscroll=onScroll;
  // 点击导航：平滑滚动后由 onScroll 校正高亮，保证"点哪亮哪"
  links.forEach((a,i)=>{
    a.onclick=()=>{ const t=secs[i]; if(t) t.scrollIntoView({behavior:'smooth',block:'start'}); setActive(i); };
  });
  setActive(0);
}
function openGtm(id){
  const g=DATA.gtms[id]||{}; const d=DATA.gtm.find(x=>x.id===id)||{};
  if(!d && !g) return;
  prdLayer.innerHTML=`
    <div class="overlay-bar">
      <span class="ob-id">${id} · 商业落地策略</span>
      <span class="ob-title">${d.title||g.anchor||'上市与商业化策略'}</span>
      <div class="ob-close" onclick="closePrd()">✕</div>
    </div>
    <div class="wrap overlay-main">
    <div class="prd-layout">
      <aside class="prd-aside">
        <div class="as-h">GTM 文档目录</div>
        <nav class="overlay-nav">
          <a onclick="prdGo('ps-01')"><span class="n">1</span>市场测算</a>
          <a onclick="prdGo('ps-01b')"><span class="n">1b</span>上市传导路径</a>
          <a onclick="prdGo('ps-02')"><span class="n">2</span>客户画像</a>
          <a onclick="prdGo('ps-03')"><span class="n">3</span>定价打包</a>
          <a onclick="prdGo('ps-04')"><span class="n">4</span>渠道策略</a>
          <a onclick="prdGo('ps-05')"><span class="n">5</span>发布节奏</a>
          <a onclick="prdGo('ps-06')"><span class="n">6</span>营销协同</a>
          <a onclick="prdGo('ps-07')"><span class="n">7</span>核心指标</a>
          <a onclick="prdGo('ps-08')"><span class="n">8</span>风险对策</a>
          <a onclick="prdGo('ps-09')"><span class="n">9</span>首批100</a>
          <a onclick="prdGo('ps-10')"><span class="n">10</span>北极星</a>
        </nav>
      </aside>
      <div class="prd-main prd-hero">
        <div class="ph-rank">${d.tag||''} · 上市后推向市场路径</div>
        <div class="prd-hero-grid">
          <div>
            <h1>${d.title||g.anchor}</h1>
            <p class="ph-val">${d.lead||''}</p>
          </div>
          <figure class="ph-figure">${DATA.fig.gtm[id]||DATA.fig.gtm[d.icon]||DATA.fig.gtm['ID-001']}</figure>
        </div>
        <div class="derive">
          <div class="derive-head">上市逻辑 · GTM</div>
          <div class="derive-chain">
            <div class="derive-step"><div class="ds-ico">1</div><div class="ds-l">需求锚点</div><div class="ds-t">${g.tamSamSom?'已验证需求规模':'目标人群'}</div></div>
            <div class="derive-step"><div class="ds-arrow">→</div><div class="ds-ico">2</div><div class="ds-l">价值主张</div><div class="ds-t">${g.anchor||d.title}</div></div>
            <div class="derive-step"><div class="ds-arrow">→</div><div class="ds-ico">3</div><div class="ds-l">渠道与节奏</div><div class="ds-t">借渠道与发布节奏快速放量</div></div>
            <div class="derive-step"><div class="ds-arrow">→</div><div class="ds-ico">4</div><div class="ds-l">北极星</div><div class="ds-t">${g.northStar||'持续校准'}</div></div>
          </div>
        </div>
        ${renderGtmDoc(id)}
      </div>
    </div>
    </div>`;
  const secs=[...prdLayer.querySelectorAll('.prd-sec')];
  secs.forEach((s,i)=>{ s.id='ps-'+(i+1).toString().padStart(2,'0'); });
  bindPrdNav();
  prdLayer.classList.add('open');
  prdLayer.scrollTop=0;
  // 触发 overlay 内进度条 / 漏斗动画
  requestAnimationFrame(()=>{ setTimeout(()=>{ prdLayer.querySelectorAll('[data-w]').forEach(b=>{ b.style.width=b.dataset.w+'%'; }); }, 80); });
}
function closePrd(){ prdLayer.classList.remove('open'); }
addEventListener('keydown',e=>{ if(e.key==='Escape'){ closePrd(); eviMask.classList.remove('open'); } });
</script>
</body>
</html>
